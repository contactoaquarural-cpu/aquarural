{
  "expo": {
    "name": "ASOGACENTRO",
    "slug": "asogacentro-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#111414"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.asogacentro.app"
    },
    "android": {
      "package": "com.asogacentro.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar foto de perfil."
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Necesitamos tu ubicación para registrar la localización de tu finca."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1A7A3C"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bc1ee1af-8601-4c69-aa3b-d5cd5549dd06"
      }
    },
    "owner": "asogacentro2026"
  }
}
