{
  "expo": {
    "name": "AquaRural",
    "slug": "aquarural",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.aquaruralprosteam.aquarural",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AquaRural necesita tu ubicación para registrar el GPS de tu predio."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1D4ED8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3a6d164b-9710-4ca1-9dbf-5011cb7ec4fc"
      }
    },
    "owner": "aquaruralpros-team"
  }
}
