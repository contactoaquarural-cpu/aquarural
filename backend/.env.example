PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/aquarural-db?retryWrites=true&w=majority

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cifrado de credenciales Wompi por acueducto (AES-256)
MASTER_ENCRYPTION_KEY=

# Seed inicial de SUPERADMIN (solo usado por `npm run seed:superadmin`)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NOMBRE=

# Wompi de MetaDevelopment (cobro de licencias SaaS a los acueductos)
WOMPI_PLATAFORMA_PUBLIC_KEY=
WOMPI_PLATAFORMA_PRIVATE_KEY=
WOMPI_PLATAFORMA_EVENTS_SECRET=
WOMPI_PLATAFORMA_INTEGRITY_SECRET=
WOMPI_PLATAFORMA_SANDBOX=true

# Prueba gratis para acueductos nuevos
DIAS_PRUEBA_GRATIS=30

# Nodemailer (recuperación de contraseña admin)
NODEMAILER_USER=
NODEMAILER_PASS=

FRONTEND_URL=http://localhost:5173

# Cloudinary (imágenes de apariencia de la plataforma: hero landing, foto login)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging (notificaciones push de Eventos hacia mobile-app)
# Cuenta de servicio generada en Firebase Console > Configuración del proyecto > Cuentas de servicio
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
